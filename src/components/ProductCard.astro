---
interface Props {
  title: string;
  description: string;
  price: string;
  image: string;
  category: string;
  slug: string;
  featured?: boolean;
  tags?: string[];
}

const { title, description, price, image, category, slug, featured = false } = Astro.props;
---

<article class:list={['product-card', { featured }]}>
  <a href={`/product/${slug}`} class="card-link">
    <div class="card-image">
      <img
        src={image}
        alt={title}
        width="400"
        height="300"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="card-body">
      <div class="card-meta">
        <a href={`/category/${category}`} class="category-badge" onclick="event.stopPropagation()">
          {category}
        </a>
        {featured && <span class="featured-badge">Featured</span>}
      </div>
      <h2 class="card-title">{title}</h2>
      <p class="card-description">{description}</p>
      <div class="card-footer">
        <span class="card-price">{price}</span>
        <span class="card-cta">View →</span>
      </div>
    </div>
  </a>
</article>
