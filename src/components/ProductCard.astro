---
interface Props {
  title: string;
  description: string;
  price: string;
  image: string;
  category: string;
  slug: string;
  featured?: boolean;
  tags?: string[];
}

const { title, description, price, image, category, slug, featured = false } = Astro.props;
---

<article class:list={['product-card', { featured }]}>
  <a href={`/product/${slug}`} class="card-link">

    <!-- blob background -->
    <div class="card-blob" aria-hidden="true"></div>

    <!-- product image (sits over blob) -->
    <img
      src={image}
      alt={title}
      width="400"
      height="300"
      loading="lazy"
      decoding="async"
      class="card-img"
    />

    <!-- top badges -->
    <div class="card-top">
      <a
        href={`/category/${category}`}
        class="category-badge"
        onclick="event.stopPropagation()"
      >{category}</a>
      {featured && <span class="featured-badge">Featured</span>}
    </div>

    <!-- bottom text -->
    <div class="card-bottom">
      <p class="card-description">{description}</p>
      <div class="card-footer">
        <h2 class="card-title">{title}</h2>
        <span class="card-price">{price}</span>
      </div>
    </div>

  </a>
</article>
